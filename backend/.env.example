# Copy to .env and fill in values (never commit .env)

OPENAI_API_KEY=

# Dev: cheap model. Production Cloud Functions defaults to gpt-4o.
OPENAI_MODEL=gpt-4o-mini

# Dev-server hardcoded login (override if needed)
DEV_AUTH_EMAIL=tech@ironpath.local
DEV_AUTH_PASSWORD=ironpath123
DEV_AUTH_SECRET=ironpath-dev-jwt-secret

# Firebase Admin — for create-mvp-user script
FIREBASE_PROJECT_ID=ironpath-diagnostics
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# MVP login credentials (created via npm run create-user)
MVP_USER_EMAIL=tech@ironpath.local
MVP_USER_PASSWORD=
